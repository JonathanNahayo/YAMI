{
  "name": "yami-backend",
  "version": "1.0.0",
  "description": "Backend serveur pour Yami - La Douce Énergie",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write src/**/*.ts",
    "setup": "npm install && Copy-Item .env.example .env"
  },
  "keywords": ["yami", "backend", "api"],
  "author": "ChainES ASBL",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "mongoose": "^8.6.0",
    "nodemailer": "^6.9.14"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.8.0",
    "@types/nodemailer": "^6.4.17",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.2"
  }
}